# Copy this file to .env for local dev, and set the same two values
# in Netlify: Site settings -> Environment variables

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local scripts only (scripts/backfill-posters.mjs --apply). Never prefix with
# VITE_, never commit it, never add it to Netlify's browser-visible variables.
# SUPABASE_SERVICE_ROLE_KEY=

# Used only at build time to write absolute URLs into sitemap.xml
SITE_URL=https://vexn.org

# Web push (new-video alerts). The public key is safe in the browser and goes into Netlify as VITE_VAPID_PUBLIC_KEY;
# without it the "Get new-video alerts" button is hidden. The private key is only for the daily GitHub Actions sender
# (.github/workflows/send-push.yml) and must stay a GitHub secret.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
