# Copy this file to .env for local dev, and set the same two values
# in Netlify: Site settings -> Environment variables

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local scripts only (scripts/backfill-posters.mjs --apply). Never prefix with
# VITE_, never commit it, never add it to Netlify's browser-visible variables.
# SUPABASE_SERVICE_ROLE_KEY=

# Used only at build time to write absolute URLs into sitemap.xml
SITE_URL=https://vexn.org
